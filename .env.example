# Rollcasters Game: runtime backend
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Production Promo Code definitions used by Local player builds. Keep these
# pointed at the Production Supabase project even when VITE_SUPABASE_URL below
# is overridden for local claims.
VITE_PROMO_DEFINITION_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_PROMO_DEFINITION_SUPABASE_PUBLISHABLE_KEY=YOUR_PRODUCTION_PUBLISHABLE_KEY

# Local player PostgreSQL/Supabase backend used by preview builds.
VITE_LOCAL_SUPABASE_URL=http://127.0.0.1:54321
VITE_LOCAL_SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_SUPABASE_PUBLISHABLE_KEY
LOCAL_PLAYER_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Game environment and immutable Catalog Release selection.
VITE_GAME_PROFILE=local
VITE_GAME_ENVIRONMENT=production
VITE_GAME_UPDATE_CHANNEL=none
VITE_EXPECTED_SUPABASE_PROJECT_REF=YOUR_PROJECT_ID
VITE_GAME_CATALOG_MODE=release
VITE_GAME_PLAYER_BOOTSTRAP_MODE=v1
# Desktop packaging injects the verified package-local loopback Catalog server.
VITE_GAME_VERSION=0.1.0
VITE_GAME_CATALOG_RELEASE_ID=2026.08.26.2
VITE_GAME_CLIENT_PROTOCOL_VERSION=1

# Local-only game account used by developer-run player tests.
GAME_ACCOUNT_EMAIL=your-game-account@example.com

# Server/tool credentials. Never expose these through VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DEV_ENABLE_USER_DELETE=false
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres
SUPABASE_DB_CA_CERT_PATH=certs/prod-ca-2021.crt
postgres_password=YOUR_DATABASE_PASSWORD

# Public key used to verify official Stable updater signatures.
TAURI_UPDATER_PUBLIC_KEY=YOUR_BASE64_TAURI_UPDATER_PUBLIC_KEY
