VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# One-database contract. Local browser/tooling and Stable use this same Production
# project. Official desktop packaging overrides the local profile to Stable and
# fails closed unless this expected project reference matches the configured URL.
VITE_GAME_PROFILE=local
VITE_GAME_ENVIRONMENT=production
VITE_GAME_UPDATE_CHANNEL=none
VITE_EXPECTED_SUPABASE_PROJECT_REF=YOUR_PROJECT_ID

# The player app consumes an immutable catalog and optimized artwork from the
# external public release host. Source/master artwork remains in the workspace
# asset library and is never requested from Supabase Storage.
VITE_GAME_CATALOG_MODE=release
VITE_GAME_PLAYER_BOOTSTRAP_MODE=v1
VITE_GAME_CATALOG_BASE_URL=https://YOUR_PUBLIC_CATALOG_BASE_URL/game-data
VITE_GAME_ASSET_BASE_URL=https://YOUR_PUBLIC_CATALOG_BASE_URL/game-assets
VITE_GAME_VERSION=0.1.0
VITE_GAME_CATALOG_RELEASE_ID=2026.08.22.1
VITE_GAME_CLIENT_PROTOCOL_VERSION=1

# Set automatically by `npm run dev:catalog`; never enable this for a Stable
# desktop build. It allows the browser harness to render an exact local
# Catalog while Production RPCs continue using the active server tuple.
# VITE_GAME_LOCAL_CATALOG_PREVIEW=true

# Optional local game-account credentials for developer-run browser tooling.
# These are not bundled into the Vite client and must never identify a
# `dev_tool_users` account.
GAME_ACCOUNT_EMAIL=your-game-account@example.com
GAME_ACCOUNT_PASSWORD=your-local-game-password

# Optional emergency fallback. Leave disabled during normal operation.
# Release mode is fail-closed: an unavailable release is an unavailable game.
# VITE_ALLOW_LEGACY_PLAYER_BOOTSTRAP=true

# Required for `db:delete-user` and all `game:grant:*` / `game:revoke:*` commands.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DEV_ENABLE_USER_DELETE=false

# Optional for local direct database migrations or `db:delete-user -- --direct-db`.
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres
SUPABASE_DB_CA_CERT_PATH=certs/prod-ca-2021.crt
postgres_password=YOUR_DATABASE_PASSWORD

# External R2 publisher settings. These are server-only and never use a VITE_
# prefix in release scripts.
RELEASE_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET=rollcasters-public
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_PUBLIC_BASE_URL=https://YOUR_PUBLIC_CATALOG_BASE_URL

# Stable desktop release repository. The updater reads latest.json from the
# latest immutable GitHub Release; no separate update host is required.
ROLLCASTERS_RELEASE_REPOSITORY=pmarshall7516/rollcaster-releases

# Official Stable packaging. Keep the private key and password in protected
# GitHub environment secrets, never in this file or any VITE_ variable.
TAURI_UPDATER_PUBLIC_KEY=YOUR_BASE64_TAURI_UPDATER_PUBLIC_KEY
# TAURI_SIGNING_PRIVATE_KEY=SET_ONLY_IN_PROTECTED_CI
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=SET_ONLY_IN_PROTECTED_CI

# Local Supabase only. Never disable TLS for a remote database.
# SUPABASE_DB_SSL=false
